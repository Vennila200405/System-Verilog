    int q1[$];
    int q2[$];

    initial begin
        q1 = '{10,20,30};
        q2 = '{40,50,60};

        $display("Before Insertion");
        $display("q1 = %p", q1);
        $display("q2 = %p", q2);
      foreach (q2[i])
            q1.push_back(q2[i]);
        $display("After Insertion");
        $display("q1 = %p", q1);
    end
endmodule

