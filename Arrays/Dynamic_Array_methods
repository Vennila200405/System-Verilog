module dynamic_arrays;
  int d[];
  int d1[];
  initial begin
    d = '{9,1,8,3,4,4};
    d1 =new[6];
    
    foreach (d1[i]) begin
      d1[i] = i;
    end
    
    $display("d1 = %p",d1);
    $display("d1 size : %0d",d1.size());
    
    d1.delete();
    $display("d1 size after delete: %0d",d1.size());
    d.sort();
    $display("Sorted d : %p", d);
    d.rsort();
    $display ("Reverse Sorted : %p",d);
    d.reverse();
    $display("Reversed d : %p", d); 
   
    d.shuffle();
    
    $display("Shuffled d : %p",d);
    
  end
endmodule
