module dynamic_array_with_sort;
  int arr[];
  initial begin
    arr = new[10];
    arr = '{45,12,89,3,67,25,90,11,56,18};
    $display("Before Sort = %p", arr);
    
    arr.sort();
   $display("After Sort = %p", arr);
  end
endmodule


// sorting without array methods

    module dynamic_array_without_sort;
  int arr[];
  int temp;
  initial begin
    arr = new[10];
    arr = '{45,12,89,3,67,25,90,11,56,18};
    $display("Before Sorting = %p",arr);
    
    for(int i = 0; i<arr.size();i++)begin
      for(int j = 0; j<arr.size()-1-i;j++)begin
        if (arr[j] > arr[j+1])begin
          temp = arr[j];
          arr[j] = arr[j+1];
          arr[j+1] = temp;
        end
      end
    end
    $display("After Sorting = %p",arr);
  end
endmodule
